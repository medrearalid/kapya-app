# Kapya Backend - Ortam Değişkenleri Şablonu
# Bu dosyayı kopyalayarak .env adıyla backend/ dizininde oluşturun.
# Gerçek değerleri .env dosyasına yazın; .env asla Git'e eklenmez.

# --- Upstash Redis (Semantic Cache) ---
UPSTASH_REDIS_REST_URL=buraya_url_gelecek
UPSTASH_REDIS_REST_TOKEN=buraya_token_gelecek

# --- Önbellek TTL (isteğe bağlı, saniye cinsinden) ---
# SEMANTIC_CACHE_TTL_SECONDS=21600
# INSIGHT_CACHE_TTL_SECONDS=1800
# SEMANTIC_CACHE_REDIS_TIMEOUT_MS=900

# --- Google Gemini API ---
GEMINI_API_KEY=buraya_api_anahtari_gelecek
# GOOGLE_API_KEY=alternatif_anahtar  # GEMINI_API_KEY bulunamazsa kullanılır

# --- Model Seçimi (isteğe bağlı, varsayılanlar aşağıdadır) ---
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TEXT_MODEL=gemini-2.5-pro
# GEMINI_VISION_MODEL=gemini-2.5-flash-lite
# GEMINI_RECEIPT_CLASSIFIER_MODEL=gemini-2.5-flash-lite

# --- Sunucu ---
# PORT=3001
